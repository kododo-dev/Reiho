<Project Sdk="Microsoft.NET.Sdk">
  
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kododo.Reiho.AspNetCore.Mcp" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".nuget\logo.png" Pack="true" PackagePath="\" />
    <None Include=".nuget\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  
  <PropertyGroup>
    <PackageId>Kododo.Reiho.AspNetCore</PackageId>
    <Authors>Kododo</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kododo-dev/Reiho</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols and source link, so apps can step into Reiho; the symbol package is pushed with the package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
</Project>
